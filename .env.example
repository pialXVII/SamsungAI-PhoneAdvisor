# Copy to .env and adjust for your machine.

# --- Database -------------------------------------------------------------
# DB_BACKEND: mysql | postgresql | sqlite
DB_BACKEND=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=samsung_phones

# PostgreSQL example:
#   DB_BACKEND=postgresql
#   DB_PORT=5432
#   DB_USER=postgres
#   DB_PASSWORD=yourpassword
#
# Zero-setup fallback (no server needed):
#   DB_BACKEND=sqlite
#
# Anything here wins over the settings above:
# DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/samsung_phones?charset=utf8mb4

# --- Scraper --------------------------------------------------------------
SCRAPER_DELAY_SECONDS=1.5
SCRAPER_MAX_LISTING_PAGES=16

# --- Models ---------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LLM_DEVICE=auto
# With LLM_DEVICE=auto, fall back to CPU when less VRAM than this is free.
# Prevents a second process from crashing with "CUDA out of memory" when the
# API server already holds the model.
LLM_MIN_FREE_VRAM_GB=4.0
# Set to false to answer from retrieved specs with templates instead of a
# generative model (useful on low-memory machines).
USE_LLM=true
RAG_TOP_K=5

# --- Multi-agent system ---------------------------------------------------
# crewai | native | auto
#   crewai — CrewAI Agent/Task/Crew running on the local model
#   native — the built-in orchestrator (~3x faster, single LLM call per agent)
#   auto   — CrewAI when installed and an LLM loads, native otherwise
AGENT_FRAMEWORK=auto

# --- API ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
